# ---------------------------------------------------------------------------
# DDNS on Route53 - environment template
#
# 1. Copy this file and keep your real values in `.env`:
#        cp .env.example .env
# 2. Never commit `.env`; it is listed in .gitignore and holds secrets.
# 3. docker-compose.yml reads `.env` through `env_file` and passes the values
#    to the container as environment variables.
#
# Full reference: docs/configuration.md
# ---------------------------------------------------------------------------

# --- Database (MySQL / MariaDB) --------------------------------------------
# Host of the database server. Use `host.docker.internal` when MySQL/MariaDB
# runs on the Docker host, or a container/service name otherwise.
DB_SERVER=host.docker.internal
# Database that stores the users, AWS credentials, DDNS entries and logs.
DB_NAME=YOURDBNAME
# Database user. It needs CREATE, SELECT, INSERT, UPDATE, DELETE and ALTER on
# the database above (setup.php creates the tables and one stored procedure).
DB_USERNAME=YOURDBUSERNAME
# Password of the database user.
DB_PASSWORD=YOURDBPASSWORD

# --- Keycloak / OpenID Connect (SSO) ---------------------------------------
# Base URL of the Keycloak server, without the `/realms/...` suffix.
# Older (legacy) deployments usually end with `/auth`.
# Examples: https://sso.example.com  |  https://sso.example.com/auth
KEYCLOAK_BASE_URL=https://sso.example.com
# Realm that contains the client used by this application. Case-sensitive.
KEYCLOAK_REALM=YOURSSORealm
# Client ID of the confidential OIDC client created in Keycloak.
KEYCLOAK_CLIENT_ID=ddnsonroute53
# Client secret of that OIDC client (Clients -> your client -> Credentials).
KEYCLOAK_CLIENT_SECRET=YOURKEYCLOAKCLIENTSECRET
# Public URL of index.php. It must be registered in the Keycloak client as a
# "Valid redirect URI" AND as a "Valid post logout redirect URI", otherwise
# login or sign-out ends on a Keycloak error page.
KEYCLOAK_REDIRECT_URI=https://ddnsonroute53.example.com/index.php

# --- SSO access restriction (optional) -------------------------------------
# Comma, semicolon or space separated list of e-mail addresses and/or domains
# allowed to sign in through SSO. Values are case-insensitive.
#
# Accepted entries:
#   admin@example.com   exact e-mail address
#   example.com         every address on that exact domain
#   @example.com        same as above
#   *@example.com       same as above
#   *                   allow every account (same as leaving this empty)
#
# Examples:
#   RESTRICT_USERS=admin@example.com,ops@example.com
#   RESTRICT_USERS=admin@example.com,example.org
#
# Matching is exact: `example.com` covers `user@example.com` but NOT
# `user@mail.example.com` or `user@evil-example.com`.
#
# LEAVE EMPTY TO DISABLE THE RESTRICTION. When a value is set, every account
# that does not match is denied, even if it exists in the local `users` table.
# A typo here locks everybody out of SSO (the denied e-mail is shown on the
# login page and written to the PHP error log to help troubleshooting).
RESTRICT_USERS=

